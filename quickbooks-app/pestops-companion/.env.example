# ── QuickBooks Online ────────────────────────────────────────────────
# From your app at https://developer.intuit.com → Dashboard → your app → Keys
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Intuit app
QBO_REDIRECT_URI=http://localhost:8000/callback
# sandbox | production  — start with sandbox; production is read-only usage for now
QBO_ENVIRONMENT=sandbox
# Filled automatically by `npm run connect` (company/realm id)
QBO_REALM_ID=

# ── FieldRoutes ──────────────────────────────────────────────────────
# Your FieldRoutes subdomain: https://{FR_SUBDOMAIN}.fieldroutes.com
FR_SUBDOMAIN=
# API credentials generated in FieldRoutes for an API user
FR_AUTH_KEY=
FR_AUTH_TOKEN=
